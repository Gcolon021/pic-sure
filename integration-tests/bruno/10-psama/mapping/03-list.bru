meta {
  name: mapping-list
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/psama/mapping
  body: none
  auth: bearer
}

auth:bearer {
  token: {{sessionToken}}
}

script:pre-request {
  if (!bru.getVar("sessionToken") && !bru.getEnvVar("sessionToken")) {
    bru.runner.skipRequest();
  }
}

assert {
  res.status: eq 200
}
