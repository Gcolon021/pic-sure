meta {
  name: mapping-create-connection
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/psama/connection
  body: json
  auth: bearer
}

auth:bearer {
  token: {{sessionToken}}
}

script:pre-request {
  if (!bru.getVar("sessionToken") && !bru.getEnvVar("sessionToken")) {
    bru.runner.skipRequest();
  }
}

body:json {
  [ { "label": "bruno-test-mapping-connection", "id": "bruno-test-map", "subPrefix": "bruno-test-map|", "requiredFields": "[{\"label\":\"Email\",\"id\":\"email\"}]" } ]
}

assert {
  res.status: eq 200
}

script:post-response {
  const body = res.body && res.body.content !== undefined ? res.body.content : res.body;
  const item = Array.isArray(body) ? body[0] : body;
  bru.setVar("brunoMapConnUuid", item.uuid);
}
