meta {
  name: privilege-get
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/psama/privilege/{{brunoPrivilegeUuid}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{sessionToken}}
}

script:pre-request {
  if (!bru.getVar("sessionToken") && !bru.getEnvVar("sessionToken")) {
    bru.runner.skipRequest();
  }
}

assert {
  res.status: eq 200
}
