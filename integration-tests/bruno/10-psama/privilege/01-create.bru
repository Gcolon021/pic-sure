meta {
  name: privilege-create
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/psama/privilege
  body: json
  auth: bearer
}

auth:bearer {
  token: {{sessionToken}}
}

script:pre-request {
  if (!bru.getVar("sessionToken") && !bru.getEnvVar("sessionToken")) {
    bru.runner.skipRequest();
  }
}

body:json {
  [ { "name": "bruno-test-privilege", "description": "created by bruno integration suite" } ]
}

assert {
  res.status: eq 200
}

script:post-response {
  const body = res.body && res.body.content !== undefined ? res.body.content : res.body;
  const item = Array.isArray(body) ? body[0] : body;
  bru.setVar("brunoPrivilegeUuid", item.uuid);
}
