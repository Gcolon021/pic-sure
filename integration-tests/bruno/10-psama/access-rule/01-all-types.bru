meta {
  name: access-rule-all-types
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/psama/accessRule/allTypes
  body: none
  auth: bearer
}

auth:bearer {
  token: {{sessionToken}}
}

script:pre-request {
  if (!bru.getVar("sessionToken") && !bru.getEnvVar("sessionToken")) {
    bru.runner.skipRequest();
  }
}

tests {
  // known bug: AccessRuleController.getAllTypes() declares `consumes =
  // APPLICATION_JSON_VALUE` on a @GetMapping; a bodyless GET has no
  // Content-Type, so the mapping fails to match and Spring falls through to
  // getAccessRuleById's /{accessRuleId} pattern, which tries
  // UUID.fromString("allTypes") -> 400. Tighten to 200 once fixed.
  test("all types is available or known-bug 400 (consumes on GET mapping)", function () {
    expect([200, 400]).to.include(res.getStatus());
  });
}
