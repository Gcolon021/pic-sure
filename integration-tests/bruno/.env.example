# Copy to .env (gitignored). Get tokens from the PSAMA UI or GET /psama/user/me?hasToken
PICSURE_USER_TOKEN=
PICSURE_ADMIN_TOKEN=
# Optional: PSAMA application JWT (subject PSAMA_APPLICATION|<uuid>), enables
# 10-psama/token/02-token-inspect. Must be an application JWT, NOT the opaque
# application secret. In a local AIO stack, the gateway's TOKEN_INTROSPECTION_TOKEN is one.
PICSURE_APPLICATION_TOKEN=
# Short-lived session JWT for PSAMA-direct endpoints (admin CRUD, token/refresh, tos).
# Copy from browser DevTools -> Local Storage -> https://localhost -> key "token" after login.
# Expires after a few hours; session-token requests are skipped when unset.
PICSURE_SESSION_TOKEN=
# Optional: PSAMA signing secret (APPLICATION_CLIENT_SECRET from the local AIO psama.env).
# When set alongside PICSURE_SESSION_TOKEN, the 10-psama folder pre-request script re-signs
# the session token's claims with a fresh exp, so an expired seed token is auto-refreshed.
# Secret and seed token stay local (.env is gitignored) — never commit them.
PSAMA_CLIENT_SECRET=
