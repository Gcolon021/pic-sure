meta {
  name: 05-query-sync
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/picsure/hpds/auth/v3/query/sync
  body: json
  auth: inherit
}

body:json {
  {
    "query": {
      "select": [],
      "authorizationFilters": [],
      "phenotypicClause": null,
      "genomicFilters": [],
      "expectedResultType": "COUNT"
    }
  }
}

assert {
  res.status: eq 200
}

tests {
  test("returns a numeric count", function () {
    expect(Number(res.getBody())).to.be.a("number");
    expect(Number(res.getBody())).to.not.be.NaN;
  });
}
