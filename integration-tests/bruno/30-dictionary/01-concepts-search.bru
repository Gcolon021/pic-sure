meta {
  name: 01-concepts-search
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/picsure/dictionary/concepts?page_number=0&page_size=10
  body: json
  auth: inherit
}

body:json {
  { "facets": [], "search": "" }
}

assert {
  res.status: eq 200
  res.body.content: isDefined
}

script:post-response {
  const first = res.body.content && res.body.content[0];
  if (first) {
    bru.setVar("dictConceptPath", first.conceptPath);
    bru.setVar("dictDataset", first.dataset);
  }
}

tests {
  test("returns at least one concept", function () {
    expect(res.getBody().content.length).to.be.greaterThan(0);
  });
}
