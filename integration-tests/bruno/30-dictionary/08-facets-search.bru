meta {
  name: 08-facets-search
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/picsure/dictionary/facets
  body: json
  auth: inherit
}

body:json {
  { "facets": [], "search": "" }
}

assert {
  res.status: eq 200
}

script:post-response {
  const cats = res.body;
  if (Array.isArray(cats) && cats[0] && cats[0].facets && cats[0].facets[0]) {
    bru.setVar("dictFacetCategory", cats[0].name);
    bru.setVar("dictFacetName", cats[0].facets[0].name);
  }
}
