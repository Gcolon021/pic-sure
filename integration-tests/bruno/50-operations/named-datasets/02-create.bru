meta {
  name: 02-create
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/picsure/operations/dataset/named
  body: json
  auth: inherit
}

body:json {
  { "queryId": "{{opsQueryId}}", "name": "bruno-test-dataset", "archived": false, "metadata": {} }
}

script:post-response {
  const b = res.body;
  bru.setVar("brunoDatasetId", b.uuid || b.id);
}

tests {
  test("named dataset is created", function () {
    expect([200, 201]).to.include(res.getStatus());
  });
}
