# Copy to .env and adjust if needed. All values have working defaults.
# Host ports — chosen to not collide with a running all-in-one stack.
GATEWAY_HOST_PORT=8081
PSAMA_HOST_PORT=8091
API_PROXY_HOST_PORT=8082
MYSQL_HOST_PORT=3307
POSTGRES_HOST_PORT=5433
# Root password for the LOCAL dev MySQL (not the AIO's).
MYSQL_ROOT_PASSWORD=picsure-local-root
